pipeline {
    agent any

    environment {
        IMAGE_NAME = "rameshbaskaran/employee-api"
        IMAGE_TAG = "v1"
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('Kubernetes/employee-api') {
                    bat 'docker build -t %IMAGE_NAME%:%IMAGE_TAG% .'
                }
            }
        }
    }
}